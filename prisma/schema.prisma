datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model users {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique
  display_name         String
  auth_hash            Bytes
  kdf_salt             Bytes
  kdf_iterations       Int
  kdf_parallelism      Int                   @db.SmallInt
  pvk_ciphertext       Bytes
  pvk_nonce             Bytes
  key_version          Int
  vault_revision       BigInt
  purged_through_revision BigInt
  email_verified_at    DateTime?             @db.Timestamptz(6)
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @updatedAt @db.Timestamptz(6)
  deleted_at           DateTime?             @db.Timestamptz(6)
  anonymized_at        DateTime?             @db.Timestamptz(6)

  sessions             sessions[]
  email_verifications  email_verifications[]
  audit_logs           audit_log[]
  vault_items          vault_items[]
  two_factor           two_factor?
  recovery_codes       recovery_codes[]

  @@map("users")
}

model sessions {
  id                         String    @id @default(uuid()) @db.Uuid
  user_id                    String    @db.Uuid
  device_name                String
  refresh_token_hash         Bytes
  previous_refresh_token_hash Bytes?   @map("previous_refresh_token_hash")
  expires_at                 DateTime  @db.Timestamptz(6)
  revoked_at                 DateTime? @db.Timestamptz(6)
  revoke_reason              String?
  created_at                 DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at               DateTime? @db.Timestamptz(6)

  user                       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  audit_logs                 audit_log[]

  @@index([user_id])
  @@map("sessions")
}

model email_verifications {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  purpose      String
  target_email String
  code_hash    Bytes
  attempts     Int       @db.SmallInt
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  expires_at   DateTime  @db.Timestamptz(6)
  consumed_at  DateTime? @db.Timestamptz(6)

  user         users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("email_verifications")
}

model audit_log {
  id          BigInt    @id @default(autoincrement())
  user_id     String    @db.Uuid
  session_id  String?   @db.Uuid
  event_type  String
  outcome     String
  occurred_at DateTime  @db.Timestamptz(6)
  metadata    Json
  prev_hash   Bytes?
  hash        Bytes

  user        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session     sessions? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  pii         audit_log_pii?

  @@index([user_id, occurred_at])
  @@index([session_id])
  @@map("audit_log")
}

model audit_log_pii {
  id          BigInt    @id
  ip          Int
  user_agent  String

  audit_log   audit_log @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("audit_log_pii")
}

model vault_items {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  version       Int
  revision      BigInt
  nonce         Bytes
  ciphertext    Bytes
  deleted_at    DateTime? @db.Timestamptz(6)
  format_version Int      @db.SmallInt
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  user          users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revision])
  @@map("vault_items")
}

model two_factor {
  user_id            String    @id @db.Uuid
  status             String
  secret_ciphertext  Bytes
  last_used_step     BigInt?
  activated_at       DateTime? @db.Timestamptz(6)
  secret_nonce       Bytes
  server_key_id      Int       @db.SmallInt
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  user               users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model recovery_codes {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  code_hash   Bytes
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  used_at     DateTime? @db.Timestamptz(6)

  user        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("recovery_codes")
}
